# === REQUIRED ===
# Same value as WHATSAPP_API_KEY in the bridge's .env.
# The MCP server presents this to the bridge's /auth/login endpoint
# to obtain a short-lived JWT for /api/* calls.
# (WHATSAPP_API_SECRET is also accepted as a deprecated alias.)
WHATSAPP_API_KEY=

# === OPTIONAL ===
# Bridge API base URL. Default: http://localhost:8080/api.
API_BASE_URL=http://localhost:8080/api

# === HTTP mode (optional) ===
# Set IS_HTTP=true to expose MCP over HTTP instead of stdio.
IS_HTTP=false
# Recommended when IS_HTTP=true (at least 32 chars). When set, every HTTP
# client must send "Authorization: Bearer <MCP_HTTP_TOKEN>". When unset, only
# loopback and private-network clients are accepted.
# Generate: openssl rand -base64 48
MCP_HTTP_TOKEN=
HTTP_BASE_URL=0.0.0.0:5777

# HTTP mode without MCP_HTTP_TOKEN only answers requests whose Host is an IP,
# localhost, a single-label name (a compose service) or a .local/.lan/.ts.net
# style name. List any other host names clients use, comma-separated.
MCP_ALLOWED_HOSTS=
# stdio mode: limit send_media media_path to these folders (OS path-list
# separator). Keys, credentials, hidden folders and AppData are refused anyway.
MEDIA_PATH_ROOTS=
